#!/bin/sh

# Release environment configuration
# This file is sourced before the release commands are executed.

# In Docker, environment variables are injected by docker-compose.
# For bare-metal, load from .env if it exists.
if [ -f /opt/loopctl/.env ]; then
  set -a
  . /opt/loopctl/.env
  set +a
fi

export RELEASE_DISTRIBUTION=name

# Distributed Erlang (test/loopctl/release_env_test.exs renders this file).
#
# On Fly the machines cluster over the private network (6PN), which is IPv6-ONLY, so:
#
# - The node is named after this machine's 6PN address (FLY_PRIVATE_IP). DNSCluster
#   (DNS_CLUSTER_QUERY, fly.toml) resolves `loopctl.internal` to every machine's address
#   and connects to `<this node's basename>@<address>`. A node named `...@127.0.0.1` can
#   never be reached that way, which is why the two production machines ran as two islands.
# - Distribution runs over `inet6_tcp`. Erlang defaults to IPv4 and there is no IPv4
#   private network on Fly: without this, peers resolve and every connect fails silently.
#   ERL_AFLAGS rather than vm.args so `start`, `remote` and `rpc` all get it.
# - The basename carries the deployed image (the tail of FLY_IMAGE_REF, as Fly's own
#   Phoenix release template does). DNSCluster only connects nodes with the SAME basename,
#   so two machines of one release cluster and an old and a new release never do. That is
#   what makes the per-build cookie (releases/COOKIE, generated by `mix release` in the
#   Docker build) sufficient: machines of one image share it, and no RELEASE_COOKIE secret
#   is needed. The cost, accepted: during a rolling deploy the replaced machine and the one
#   still on the old release do not see each other until the second is replaced too.
#   Mixed-release clusters are the thing avoided — their Presence replicas, PubSub
#   messages and `:global` names would have to agree across two versions of the code.
#
# Slow links: the distribution tick is the default (`net_ticktime` 60 s, so a silent peer
# is declared down after 45-75 s). Phoenix.Tracker (runner Presence) goes by its own
# heartbeats: a replica silent for 30 s (its default down_period) is marked down and its
# entries dropped until it is heard from again. Within one Fly region the 6PN round trip is
# well under a millisecond, so neither is tuned; shorter periods would trade that for false
# "down" verdicts on a GC pause of a 512 MB shared-CPU machine.
#
# Off Fly (docker-compose, bare metal) nothing clusters: the node stays on 127.0.0.1 and
# IPv4, exactly as before.
if [ -n "${FLY_PRIVATE_IP}" ]; then
  image="${FLY_IMAGE_REF##*-}"
  image=$(printf '%s' "${image}" | tr -c 'A-Za-z0-9_' '_')

  if [ -n "${image}" ]; then
    export RELEASE_NODE="${RELEASE_NAME}-${image}@${FLY_PRIVATE_IP}"
  else
    export RELEASE_NODE="${RELEASE_NAME}@${FLY_PRIVATE_IP}"
  fi

  export ERL_AFLAGS="-proto_dist inet6_tcp${ERL_AFLAGS:+ ${ERL_AFLAGS}}"
else
  export RELEASE_NODE="${RELEASE_NAME}@127.0.0.1"
fi

# Configure the BEAM VM
export ERL_FLAGS="+sbwt none +sbwtdcpu none +sbwtdio none"
