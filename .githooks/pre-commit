#!/bin/bash
# The commit gate for one repository holding three projects (US-52.6). Each area is judged
# by its own checks, and only when a staged path lies in it:
#
#   runner/                     mix precommit in runner/
#   priv/runner_contract/       the runner's check and the fleet hook: the runner compiles
#                               the contract in, and the server exports it
#   chg/ but the adapters below cargo fmt --all --check, cargo clippy, cargo test in chg/
#   chg/bin/, chg/tests/        also python3 tests/loop-test.py and replay-selection-test.py
#   chg/adapters/elixir/        mix format --check-formatted, compile, test there
#   chg/adapters/typescript/    node --test of its unit and integration tests there
#   chg/adapters/generic/       python3 adapters/generic/test/test_adapter.py from chg/
#   e2e/                        format check, compile, credo --strict and mix test --exclude
#                               live there; the live run needs the sandbox and its secrets
#   anything else               the fleet's pre-commit ($HOME/.git-hooks/pre-commit), which
#                               gates the root mix project as it always has
#
# A commit staging only runner/, chg/ or e2e/ paths never runs the root mix precommit, which
# knows nothing about them.
#
# The fleet hook runs last, through exec, so it keeps its own path in $0 (it resolves its
# lib directory from it). Without the fleet hook, git would have run no pre-commit at all,
# so this says so and lets git go on rather than stopping every commit on a machine that
# has not synced claude-config.
set -uo pipefail

root=$(git rev-parse --show-toplevel) || exit 1

runner=false chg=false chg_py=false elixir_adapter=false ts_adapter=false generic_adapter=false
e2e=false
outside=false staged=false
# Every arm sets at least one flag, so no staged path passes with no check at all.
while IFS= read -r -d '' path; do
  staged=true
  case $path in
    runner/*) runner=true ;;
    # The runner compiles the contract in (@external_resource) and the server exports it.
    priv/runner_contract/*) runner=true outside=true ;;
    chg/adapters/elixir/*) elixir_adapter=true ;;
    chg/adapters/typescript/*) ts_adapter=true ;;
    chg/adapters/generic/*) generic_adapter=true ;;
    # chg's Python: the loop and its replay tests, as chg-ci's generic-adapter job runs them.
    # cargo runs too, since the Rust tests drive these scripts.
    chg/bin/* | chg/tests/*) chg=true chg_py=true ;;
    # Any other chg/ path, an adapter directory none of the arms above claims included.
    chg/*) chg=true ;;
    e2e/*) e2e=true ;;
    *) outside=true ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMRD)

# check <area> <dir> <command...>: runs the command in <dir>, and on failure names the area
# and stops the commit. A commit that deletes the whole area leaves nothing to check.
check() {
  local area=$1 dir=$2
  shift 2
  if [ ! -d "$root/$dir" ]; then
    echo "▷ $area: $dir/ is gone in this commit; nothing to check"
    return 0
  fi
  echo "▶ $area: $*"
  if ! (cd "$root/$dir" && "$@"); then
    echo "❌ $area: '$*' failed in $dir/; the commit is stopped" >&2
    exit 1
  fi
}

if $runner; then
  check runner runner mix precommit
fi

if $chg; then
  check chg chg cargo fmt --all --check
  check chg chg cargo clippy --all-targets --locked -- -D warnings
  check chg chg cargo test --locked
fi

if $chg_py; then
  check chg chg python3 tests/loop-test.py
  check chg chg python3 tests/replay-selection-test.py
fi

if $elixir_adapter; then
  check chg/adapters/elixir chg/adapters/elixir mix format --check-formatted
  check chg/adapters/elixir chg/adapters/elixir mix compile --warnings-as-errors
  check chg/adapters/elixir chg/adapters/elixir mix test
fi

if $ts_adapter; then
  check chg/adapters/typescript chg/adapters/typescript \
    node --test test/unit.test.mjs test/integration.test.mjs
fi

if $generic_adapter; then
  check chg/adapters/generic chg python3 adapters/generic/test/test_adapter.py
fi

if $e2e; then
  check e2e e2e mix format --check-formatted
  check e2e e2e mix compile --warnings-as-errors
  check e2e e2e mix credo --strict --config-file .credo.exs
  check e2e e2e mix test --exclude live
fi

# A commit staging nothing (an --allow-empty, a message-only amend) is the fleet hook's to
# judge, as it was before this file routed anything.
$outside || ! $staged || exit 0

fleet="$HOME/.git-hooks/pre-commit"
if [ ! -x "$fleet" ]; then
  echo "⚠️  $fleet not found: the fleet's pre-commit did not run; re-sync claude-config" >&2
  exit 0
fi
exec "$fleet" "$@"
