{
  "runs_dir": "~/.local/state/loopctl-runner/runs",
  "claude_projects_dir": "~/.claude/projects",
  "claude_launcher": "~/workspace/claude-config/bin/claude-headless.sh",
  "repos": {
    "home_care_billing": "~/workspace/home_care_billing"
  },
  "branch_prefixes": [
    "loop/"
  ],
  "allowed_tools": [
    "Bash(mix test:*)",
    "Bash(mix compile:*)",
    "Bash(mix format:*)"
  ],
  "max_wall_clock_s": 3600,
  "max_turns": 200,
  "park_after_s": 600,
  "liveness_interval_s": 30,
  "kill_grace_s": 10,
  "tree_poll_s": 1,
  "agents_probe_timeout_s": 20,
  "control": {
    "url": "wss://loopctl.com/runner/socket/websocket",
    "runner_id": "<runner.id returned by runner_enroll>",
    "machine": "minis",
    "token_file": "~/.config/loopctl-runner/token",
    "repos": [
      "mkreyman/home_care_billing"
    ],
    "max_sessions": 2,
    "status_interval_s": 30
  }
}
