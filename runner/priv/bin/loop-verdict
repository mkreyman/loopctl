#!/usr/bin/env bash
# loop-verdict — the one way an unattended triage session states its verdict.
#
#   /abs/path/loop-verdict <token> <<'VERDICT'
#   { "outcome": "story", "confidence": "high", ... }
#   VERDICT
#
# The verdict is `RunnerTriageVerdict` (in the contract since 1.7.0), read from stdin as JSON. It is the
# session's ONLY output that matters: a triage session writes nothing, opens nothing and
# touches no worktree, so this file is the run's product.
#
# Why a command rather than a parsed transcript: the same reason escalation is one
# (`loop-escalate`). A session's prose is untrusted text that has just read a reporter's
# untrusted text; scraping a verdict out of it would be parsing the thing the fence exists to
# keep unparsed. Here the session fills a form, and the runner validates it against the
# contract before anything is sent.
#
# This script restates no part of the contract: the shape, the bounds and the byte rule are
# `LoopctlRunner.TriageVerdict`'s to enforce, and it asks that module (through the release, see
# the check below) before it records anything. It caps what it will store so a runaway session
# cannot fill the disk, and refuses a second verdict, since a run states one.

set -u

: "${LOOP_RUN_DIR:?loop-verdict only works inside a loop session}"

# THE TOKEN IS THE CAPABILITY, and it is carried in the session's PROMPT rather than its
# environment, because a subagent inherits the environment. The session's own allow-rule lets any
# subagent it dispatches run this script — a built-in agent type declares no tool restriction and
# is bounded only by the session's tool pool — and the verdict is first-write-wins, so without
# this a fourth reading could fix the run's answer. The token reaches the session and nothing else.
expected=$(cat "$LOOP_RUN_DIR/verdict.token" 2> /dev/null || true)

if [ -z "$expected" ]; then
    echo "this run has no verdict token; the runner did not start it as a triage run" >&2
    exit 2
fi

if [ "${1:-}" != "$expected" ]; then
    echo "state the verdict as: loop-verdict <the token from your prompt> <<'VERDICT' ... VERDICT" >&2
    exit 2
fi

# Above any verdict the contract admits (48000 bytes under its byte rule, which charges at
# least 6 per character), and far below anything that threatens the disk.
max_bytes=262144
out="$LOOP_RUN_DIR/verdict.json"

if [ -e "$out" ]; then
    echo "a verdict was already stated for this run; it is the one that counts" >&2
    exit 3
fi

if [ -t 0 ]; then
    echo "usage: loop-verdict <<'VERDICT' {\"outcome\": ..., \"confidence\": ...} VERDICT" >&2
    exit 2
fi

umask 077
tmp=$(mktemp "$LOOP_RUN_DIR/.verdict.XXXXXX") || exit 1
trap 'rm -f "$tmp" "$tmp.check"' EXIT

# STRAIGHT TO THE FILE, never through a shell variable. Command substitution strips every
# trailing newline and drops NUL bytes, so `$(head -c N)` measured a cut that landed on a newline
# as exactly N — inside the cap — and stored the truncated fragment while telling the session it
# had succeeded. Its retry then hit the one-verdict refusal, leaving the run's only product
# unreadable. Measuring the FILE also measures bytes, which is what `head -c` reads: `${#var}`
# counts characters under a UTF-8 locale, and agrees only for ASCII, which is why the first two
# versions of this were wrong in the same direction.
head -c "$((max_bytes + 1))" > "$tmp" || exit 1
bytes=$(wc -c < "$tmp")

if [ "$bytes" -gt "$max_bytes" ]; then
    echo "the verdict is over $max_bytes bytes; nothing was recorded" >&2
    exit 2
fi

if [ "$(tr -d '[:space:]' < "$tmp" | wc -c)" -eq 0 ]; then
    echo "the verdict was empty; state one RunnerTriageVerdict object as JSON" >&2
    exit 2
fi

# The shape a JSON object has, checked here so the message below is not a lie about bytes that
# are plainly not a verdict. Everything else — the schema, the bounds, the byte rule, the
# conditional story rule — is `LoopctlRunner.TriageVerdict`'s, where the contract lives.
first=$(tr -d '[:space:]' < "$tmp" | head -c 1)
last=$(tr -d '[:space:]' < "$tmp" | tail -c 1)

if [ "$first" != "{" ] || [ "$last" != "}" ]; then
    echo "the verdict is not a JSON object; state one RunnerTriageVerdict object as JSON" >&2
    exit 2
fi

# JUDGED BEFORE IT IS RECORDED, by the runner's own validator, because a recorded verdict cannot
# be restated and the session is the only one who can fix it. Until 2026-11-07 this script
# recorded first and the runner judged after the session ended: one `evidence` string past its
# 150-character cap then discarded a whole triage as `verdict_invalid`, five HCB tickets of five.
# `LOOP_VERDICT_CHECK` is the release's bin script (`LoopctlRunner.Session.verdict_check/1`), and
# `eval` runs `TriageVerdict.check_file/1` on these exact bytes in a fresh VM, so there is one
# contract and this script restates none of it. Exit 65 means the verdict breaks the contract:
# nothing is recorded and the session corrects it. Any other failure means the CHECK did not run,
# and the verdict is recorded unchecked as before, because losing it to a broken checker is worse.
checked=0
checker="${LOOP_VERDICT_CHECK:-}"

if [ -n "$checker" ]; then
    # BOUNDED, so a checker VM that stalls costs at most this long and then falls through to the
    # unchecked recording below instead of hanging the session's only output command. A portable
    # watchdog rather than timeout(1), which macOS does not ship. The check takes ~0.5 s.
    limit_s="${LOOP_VERDICT_CHECK_TIMEOUT_S:-30}"
    LOOP_VERDICT_FILE="$tmp" "$checker" eval 'LoopctlRunner.TriageVerdict.check_cli()' > "$tmp.check" 2>&1 &
    pid=$!
    ticks=0

    while kill -0 "$pid" 2> /dev/null; do
        if [ "$ticks" -ge "$((limit_s * 10))" ]; then
            kill -KILL "$pid" 2> /dev/null
            break
        fi

        sleep 0.1
        ticks=$((ticks + 1))
    done

    wait "$pid" 2> /dev/null
    status=$?
    problems=$(cat "$tmp.check" 2> /dev/null)
    rm -f "$tmp.check"

    case "$status" in
        0)
            checked=1
            ;;
        65)
            echo "NOTHING WAS RECORDED: the verdict breaks the contract and the runner would discard it:
$problems
Correct exactly those fields (a field 'longer than N' must be cut to N characters or fewer) and
state the whole verdict again with the same command." >&2
            exit 4
            ;;
        *)
            echo "note: the verdict could not be checked before recording (exit $status); it is recorded as stated" >&2
            ;;
    esac
fi

# `ln` refuses an existing target, so the claim is atomic. The check at the top reads better in
# the usual case; it is not the guarantee, because the whole of stdin is read between it and here
# and the Bash tool can run two of these at once — with `mv`, both would pass the check and the
# LAST would win, which is the opposite of one verdict per run.
if ! ln "$tmp" "$out" 2> "$tmp.err"; then
    # Only an existing target means a verdict was already stated. Anything else — no hard links
    # on this filesystem, a permissions change — is a write failure, and saying "already stated"
    # would stop the session over a verdict that does not exist.
    if [ -e "$out" ]; then
        echo "a verdict was already stated for this run; it is the one that counts" >&2
        rm -f "$tmp.err"
        exit 3
    fi

    echo "the verdict could not be recorded: $(cat "$tmp.err")" >&2
    rm -f "$tmp.err"
    exit 1
fi

rm -f "$tmp.err"

if [ "$checked" -eq 1 ]; then
    echo "Verdict recorded and valid against the contract. A run states one verdict, so this cannot
be restated. Stop working now: make no further changes and end your turn."
else
    echo "Verdict recorded, and not yet validated: the runner checks it against the contract, and a
run states one verdict, so this cannot be restated. Stop working now: make no further changes and
end your turn."
fi
