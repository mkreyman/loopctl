#!/usr/bin/env bash
# loop-push — how a loop session pushes its branch: fetch first, integrate, never force.
#
#   /abs/path/loop-push
#
# loopctl's merge executor may move a thread branch itself: when the base moved on, its App
# merges the base into loop/<story> and records a base_update checkpoint, and nothing tells the
# session. A push from the stale local head is then refused as non-fast-forward, and a FORCED
# push would erase the base update and create a head nobody reported (loopctl-runner#56). So:
#
#   1. ask origin where the session's branch is, and fetch it when that is not what the
#      repository already holds;
#   2. if origin has commits this branch lacks, MERGE them (merge, not rebase: a rebase rewrites
#      commits that may already be reported as checkpoints);
#   3. push without force. Refused: back to 1, which asks origin again. The branch moved since
#      (another push, loopctl's merge executor): go round. It did not move: the refusal is
#      something else, and git's words are shown. It was deleted: loopctl merged the thread, and
#      pushing would bring it back, so stop. Git's own words never decide.
#
# Only the session's own branch, named by LOOP_BRANCH, which the runner sets. Unset is a refusal,
# not permission to push whatever is checked out: fail closed.
#
# Each push is recorded for the runner, which reports it to loopctl as a checkpoint: one line,
# "<commit_sha> <tree_sha>", appended to checkpoints.log in LOOP_RUN_DIR, which the runner sets.
# Unset is a refusal too: a push nothing records is work nothing merges.
#
# Exit 0 pushed and recorded (the sha is printed); 2 refused to run (LOOP_BRANCH or LOOP_RUN_DIR unset, a detached HEAD, or
# another branch); 3 origin's commits CONFLICT with yours (the merge was aborted, nothing pushed);
# 4 the push failed, or origin kept moving; 5 git refused to merge at all (uncommitted changes
# in the way, or a repository error), or a conflicted merge could not be aborted, with git's words;
# 6 pushed, but the push could not be recorded.
#
# Nothing it runs can wait on a person or on a dead connection: no credential prompt, ssh in
# BatchMode with keepalives, and https given up when it stalls. An operator's own GIT_SSH_COMMAND
# is kept.

set -u
export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=4}"
net=(-c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60)

if [ -z "${LOOP_BRANCH:-}" ]; then
    echo "loop-push: LOOP_BRANCH is not set, so there is no branch this session may push" >&2
    exit 2
fi

if [ -z "${LOOP_RUN_DIR:-}" ]; then
    echo "loop-push: LOOP_RUN_DIR is not set, so a push could not be recorded for loopctl to merge" >&2
    exit 2
fi

# The FULL ref: --short turns into "heads/<branch>" when a tag or remote shares the short name.
head_ref=$(git symbolic-ref --quiet HEAD) || {
    echo "loop-push: HEAD is not on a branch; check out $LOOP_BRANCH first" >&2
    exit 2
}

if [ "$head_ref" != "refs/heads/$LOOP_BRANCH" ]; then
    echo "loop-push: on ${head_ref#refs/heads/}, but this session's branch is $LOOP_BRANCH" >&2
    exit 2
fi

branch=$LOOP_BRANCH

remote="refs/remotes/origin/$branch"
# Where origin's branch was when the last refused push was made, and what that push said.
prev=""
said=""

# The first and last lines of `$1` when it is long: a hook's reason is often at the top, git's own
# at the bottom.
brief() {
    printf '%s\n' "$1" | awk '{ line[NR] = $0 } END {
        if (NR <= 30) { for (i = 1; i <= NR; i++) print line[i] }
        else { for (i = 1; i <= 15; i++) print line[i]; print "..."; for (i = NR - 14; i <= NR; i++) print line[i] }
    }'
}

# Three pushes; a fourth round only asks origin what became of the third.
for attempt in 1 2 3 4; do
    # Where origin's branch is now: a commit, or "none" when origin has no such branch.
    if ls_out=$(git "${net[@]}" ls-remote --exit-code origin "refs/heads/$branch" 2>&1); then
        now=${ls_out%%[[:space:]]*}
    elif [ $? -eq 2 ]; then
        now=none
    else
        echo "loop-push: could not ask origin where $branch is: $(brief "$ls_out")${said:+. The last push said: $said}" >&2
        exit 4
    fi

    if [ -n "$prev" ]; then
        if [ "$now" = none ] && [ "$prev" != none ]; then
            # loopctl merges a finished thread and deletes its branch; pushing would bring it back.
            echo "loop-push: origin deleted $branch after a push was refused; nothing more was pushed, and its work may already be merged. The push said: $said" >&2
            exit 4
        fi
        if [ "$now" = "$prev" ]; then
            echo "loop-push: the push failed, and origin's $branch did not move, so pushing again would fail the same way. If git says a lock was held on origin, running loop-push again is safe. The push said: $said" >&2
            exit 4
        fi
    fi

    [ "$attempt" -gt 3 ] && break

    # Only a ref origin has is fetched, and only when the repository does not already hold it.
    if [ "$now" != none ] && [ "$(git rev-parse --verify --quiet "$remote")" != "$now" ]; then
        if ! out=$(git "${net[@]}" fetch --quiet origin "+refs/heads/$branch:$remote" 2>&1); then
            echo "loop-push: origin's $branch is at $now, and fetching it failed: $(brief "$out")" >&2
            exit 4
        fi
    fi

    if [ "$now" != none ]; then
        git merge-base --is-ancestor "$remote" HEAD
        case $? in
            0) ;; # origin has nothing this branch lacks
            1)
                if ! merge_out=$(git merge --no-edit "$remote" 2>&1); then
                    # MERGE_HEAD exists only when the merge started and stopped on conflicts.
                    if git rev-parse --verify --quiet MERGE_HEAD > /dev/null; then
                        if ! abort_out=$(git merge --abort 2>&1); then
                            echo "loop-push: origin/$branch conflicts with yours, and the merge could not be aborted; the tree is mid-merge: $abort_out" >&2
                            exit 5
                        fi
                        echo "loop-push: origin/$branch has commits that conflict with yours; nothing was pushed." >&2
                        echo "Merge origin/$branch, resolve the conflicts, commit, and run loop-push again." >&2
                        exit 3
                    fi
                    echo "loop-push: git would not merge origin/$branch: $merge_out" >&2
                    exit 5
                fi
                ;;
            *)
                echo "loop-push: could not compare origin/$branch with HEAD (a repository error)" >&2
                exit 5
                ;;
        esac
    fi

    if out=$(git "${net[@]}" push --porcelain origin "HEAD:refs/heads/$branch" 2>&1); then
        sha=$(git rev-parse HEAD)
        # What loopctl merges is what the runner reports, and it reports what is recorded here:
        # a push left unrecorded is work nothing ever merges, so it is a failure, and running
        # loop-push again (nothing new to push) records it.
        # An append a full disk cut short left a line with no newline: end it first, so this
        # line is whole and the fragment is a line of its own the runner skips.
        log="$LOOP_RUN_DIR/checkpoints.log"
        lead=""
        if [ -s "$log" ] && [ -n "$(tail -c 1 "$log")" ]; then
            lead='\n'
        fi
        if ! tree=$(git rev-parse "HEAD^{tree}") ||
            ! printf "$lead%s %s\\n" "$sha" "$tree" >> "$log"; then
            echo "loop-push: pushed $sha to origin/$branch, but could not record it for loopctl, so nothing will merge it; run loop-push again" >&2
            exit 6
        fi
        echo "pushed $sha to origin/$branch"
        exit 0
    fi

    # Refused: the next round asks origin whether the branch moved.
    prev=$now
    said=$(brief "$out")
done

echo "loop-push: origin/$branch kept moving across 3 attempts; nothing more was pushed. The last push said: $said" >&2
exit 4
