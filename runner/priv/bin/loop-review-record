#!/usr/bin/env perl
# loop-review-record — what `loop-finding` and `loop-review-verdict` run. Not named in any prompt:
# a session reaches it only through those two, which pass the kind as the first argument.
#
#   loop-review-record finding <token> --severity <severity> [--location <file:line>]
#                      [--introduced-by <this checkpoint's id|none>]  < body
#   loop-review-record verdict <token>                          < body
#
# Appends ONE JSON object to $LOOP_RUN_DIR/judgements.ndjson. The runner turns those lines into
# `review_finding` and `review_verdict` messages once the session has ended
# (LoopctlRunner.ReviewJudgements), numbering them in the order they were stated here.
#
# WHY THIS CHECKS SO MUCH. A judgement the runner refuses after the session has ended is a defect
# nobody is told about, and loopctl refuses a malformed one `invalid_payload`, permanently. So
# everything that decides whether a judgement can be sent is checked HERE, while the session can
# still correct it: the severity, the round rule on --introduced-by, the UTF-8 byte caps, and the
# contract's byte rule. Every number comes from $LOOP_RUN_DIR/review.form.json, which the runner
# writes from the vendored contract (LoopctlRunner.ReviewDispatch.form/1) — none is typed here.
#
# ONE VERDICT, AND NOTHING AFTER IT. The check and the append happen under an exclusive lock on
# the judgements file, so two calls at once cannot both find no verdict and both write one.
#
# THE TOKEN IS THE CAPABILITY, carried in the session's PROMPT rather than its environment, for the
# reason loop-verdict gives: a subagent inherits the environment, and without it a subagent could
# state the review's verdict — which completes the round — in the session's name.

use strict;
use warnings;
use Encode qw(decode encode FB_CROAK);
use Fcntl qw(:flock SEEK_SET);
use JSON::PP;
use POSIX qw(strftime);

my $kind = shift @ARGV // '';
my $name = $kind eq 'verdict' ? 'loop-review-verdict' : 'loop-finding';

sub fail {
    my ($status, $message) = @_;
    print STDERR "$message\n";
    exit $status;
}

sub usage {
    fail(2, $kind eq 'verdict'
        ? "state the verdict as: $name <the token from your prompt> <<'VERDICT' ... VERDICT"
        : "report a finding as: $name <the token from your prompt> --severity <severity> "
          . "[--location <file:line>] [--introduced-by <this checkpoint's id|none>] <<'FINDING' ... FINDING");
}

fail(2, "unknown judgement kind") unless $kind eq 'finding' || $kind eq 'verdict';

my $dir = $ENV{LOOP_RUN_DIR};
fail(2, "$name only works inside a loop session") unless defined $dir && $dir ne '';

sub slurp {
    my ($path) = @_;
    open(my $fh, '<:raw', $path) or return undef;
    local $/;
    my $content = <$fh>;
    close $fh;
    return $content;
}

my $expected = slurp("$dir/review.token");
$expected =~ s/\s+\z// if defined $expected;
fail(2, "this run has no review token; the runner did not start it as a review run")
    unless defined $expected && $expected ne '';

my $token = shift @ARGV // '';
usage() unless $token eq $expected;

my $form_raw = slurp("$dir/review.form.json");
fail(1, "this run has no review form; the runner did not start it as a review run")
    unless defined $form_raw;
my $form = eval { JSON::PP->new->utf8->decode($form_raw) };
fail(1, "this run's review form is unreadable") unless ref $form eq 'HASH';

# An argument is bytes; the session writes UTF-8, and anything else would not survive as JSON.
sub text_arg {
    my ($flag, $value) = @_;
    my $copy = $value;
    my $text = eval { decode('UTF-8', $copy, FB_CROAK) };
    fail(2, "$flag is not UTF-8 text; nothing was recorded") unless defined $text;
    return ($text, length($value));
}

my %opt;
while (@ARGV) {
    my $flag = shift @ARGV;
    usage() if $kind eq 'verdict';
    usage() unless $flag =~ /\A--(severity|location|introduced-by)\z/;
    usage() unless @ARGV;
    fail(2, "$flag was given twice; nothing was recorded") if exists $opt{$1};
    $opt{$1} = shift @ARGV;
}

usage() if -t STDIN;

# The cap is on what is RECORDED, which is the body after its trailing whitespace is trimmed: the
# heredoc's own newline is not part of what was said, so a body exactly at the cap still goes.
# Reading stops at a bound past the cap, straight from stdin: a runaway body is refused, never cut.
my $max_bytes = $kind eq 'verdict' ? $form->{verdict_body_max_bytes} : $form->{body_max_bytes};
my $read_bound = $max_bytes + 65536;
my $over = "the $kind is over $max_bytes UTF-8 bytes; nothing was recorded. Say it in fewer words";
my $raw = '';
binmode STDIN;
while (length($raw) <= $read_bound) {
    my $got = read(STDIN, my $chunk, 65536);
    fail(1, "stdin could not be read: $!") unless defined $got;
    last if $got == 0;
    $raw .= $chunk;
}

fail(2, $over) if length($raw) > $read_bound;

my $copy = $raw;
my $body = eval { decode('UTF-8', $copy, FB_CROAK) };
fail(2, "the $kind is not UTF-8 text; nothing was recorded") unless defined $body;
$body =~ s/\s+\z//;
fail(2, "the $kind was empty; nothing was recorded") unless $body =~ /\S/;
fail(2, $over) if length(encode('UTF-8', $body)) > $max_bytes;

# The contract's byte rule, as the runner measures the message: `per_char` for every UTF-16 code
# unit of the text, which is two for a character outside the Basic Multilingual Plane. The budget
# is what the message cap leaves once everything else in the message is at its widest.
sub units {
    my ($text) = @_;
    my $units = 0;
    $units += ord($_) > 0xFFFF ? 2 : 1 for split //, $text;
    return $units;
}

my %record = (kind => $kind, body => $body);

if ($kind eq 'finding') {
    my $severity = $opt{severity};
    my @allowed = @{ $form->{severities} };
    fail(2, "--severity is required: one of " . join(', ', @allowed) . "; nothing was recorded")
        unless defined $severity;
    fail(2, "--severity must be one of " . join(', ', @allowed) . "; nothing was recorded")
        unless grep { $_ eq $severity } @allowed;
    $record{severity} = $severity;

    if (exists $opt{location}) {
        my ($location, $bytes) = text_arg('--location', $opt{location});
        fail(2, "--location was empty; nothing was recorded") unless $location =~ /\S/;
        fail(2, "--location is over $form->{location_max_bytes} UTF-8 bytes; nothing was recorded")
            if $bytes > $form->{location_max_bytes};
        $record{location} = $location;
    }

    my $round = $form->{round};

    if ($round == 1) {
        fail(2, "this is round 1: a finding carries no --introduced-by; nothing was recorded")
            if exists $opt{'introduced-by'};
    } else {
        my $checkpoint = $form->{checkpoint_id} // '';
        fail(2, "this is round $round: every finding needs --introduced-by: $checkpoint when this "
            . "checkpoint's fix introduced the defect, or none; nothing was recorded")
            unless exists $opt{'introduced-by'};
        # The runner knows ONE checkpoint, the one under review, so that id or none is all a finding
        # may name. Compared without regard to case, and recorded as the form spells it: loopctl's
        # own id, which is what the runner checks again before sending it (ReviewDispatch).
        my $introduced = lc $opt{'introduced-by'};
        if ($introduced eq 'none') {
            $record{introduced_by} = 'none';
        } elsif ($checkpoint ne '' && $introduced eq lc $checkpoint) {
            $record{introduced_by} = $checkpoint;
        } else {
            fail(2, "--introduced-by must be $checkpoint (this checkpoint) or none; nothing was "
                . "recorded");
        }
    }
}

my $budget = $kind eq 'verdict' ? $form->{verdict_budget} : $form->{finding_budget};
my $cost = 0;
$cost += $form->{per_char} * units($record{$_}) for grep { exists $record{$_} } qw(body location introduced_by);
fail(2, "the $kind is too long for one message under the contract's byte rule (it costs $cost of "
    . "$budget); nothing was recorded. Say it in fewer words, or split a finding in two")
    if $cost > $budget;

$record{ts} = strftime('%Y-%m-%dT%H:%M:%SZ', gmtime);
$record{session_id} = $ENV{LOOP_SESSION_ID} // '';

umask 077;
my $path = "$dir/judgements.ndjson";
# A bound on the file, so a runaway session cannot fill the disk; far above any real review.
my $max_file = 8 * 1024 * 1024;

open(my $fh, '+>>:raw', $path) or fail(1, "the $kind could not be recorded: $!");
flock($fh, LOCK_EX) or fail(1, "the $kind could not be recorded: $!");
seek($fh, 0, SEEK_SET);

while (my $line = <$fh>) {
    my $stated = eval { JSON::PP->new->utf8->decode($line) };
    next unless ref $stated eq 'HASH' && ($stated->{kind} // '') eq 'verdict';
    fail(3, "the review's verdict was already stated; it is the one that counts, and nothing "
        . "is accepted after it");
}

my $size = -s $fh;
fail(2, "this run has recorded as many judgements as it may; nothing was recorded")
    if ($size || 0) > $max_file;

my $line = JSON::PP->new->utf8->canonical->encode(\%record) . "\n";
my $written = syswrite($fh, $line);
fail(1, "the $kind could not be recorded: $!") unless defined $written && $written == length $line;
close($fh) or fail(1, "the $kind could not be recorded: $!");

if ($kind eq 'verdict') {
    print "Verdict recorded: the review is complete and nothing more is accepted for it. Stop "
        . "working now: make no further changes and end your turn.\n";
} else {
    print "Finding recorded. The runner sends it to loopctl when your session ends. Report every "
        . "other defect the same way, then state the verdict.\n";
}
