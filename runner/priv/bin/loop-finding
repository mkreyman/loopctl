#!/usr/bin/env bash
# loop-finding — the one way an unattended review session reports a defect.
#
#   /abs/path/loop-finding <token> --severity <critical|high|medium|low> \
#       [--location <file:line>] [--introduced-by <this checkpoint's id|none>] <<'FINDING'
#   <the failure scenario: what is wrong, and one concrete way it fails>
#   FINDING
#
# One call per defect. The body is read from stdin through a QUOTED heredoc, so the shell expands
# nothing in it. Everything is checked and recorded by `loop-review-record`, beside this file; see
# it for why. The runner sends what is recorded as `review_finding` messages once the session ends.

set -u
exec perl "$(dirname "$0")/loop-review-record" finding "$@"
