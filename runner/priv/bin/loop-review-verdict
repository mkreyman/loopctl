#!/usr/bin/env bash
# loop-review-verdict — the one way an unattended review session states its verdict.
#
#   /abs/path/loop-review-verdict <token> <<'VERDICT'
#   <the verdict, in your own words>
#   VERDICT
#
# ONE per review, stated LAST: it completes the review's round, and nothing is accepted after it —
# a finding stated afterwards is refused here, and the runner would not send it anyway. Whether the
# round asked for changes is decided by the findings, never by this text. Checked and recorded by
# `loop-review-record`, beside this file.

set -u
exec perl "$(dirname "$0")/loop-review-record" verdict "$@"
