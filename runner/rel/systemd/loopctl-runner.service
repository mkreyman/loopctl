# systemd --user unit for the loopctl runner (design §14). Rendered by rel/install.sh,
# which fills in the release path and PATH.
#
# Three traps, kept out on purpose:
#  - ExecStart uses `start`. `foreground` is Distillery and does not exist in Elixir
#    releases: it fails "Unknown command" and loops.
#  - No DynamicUser=true. The runner must be the real user: it reaches ~/.claude,
#    ~/workspace, asdf shims and this machine's GitHub credentials.
#  - `start` runs in the foreground, so logs go to the journal. A release started with
#    `daemon` would log to tmp/log/erlang.log.1 under the release root instead.

[Unit]
Description=loopctl runner
Documentation=https://github.com/mkreyman/loopctl-runner
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
Environment=LOOPCTL_RUNNER_DAEMON=1
Environment=LOOPCTL_RUNNER_CONFIG=@CONFIG@
Environment=ERL_CRASH_DUMP_SECONDS=0
Environment=PATH=@PATH@
ExecStart=@RELEASE@/bin/loopctl_runner start
# No ExecStop: `bin/loopctl_runner stop` is an rpc, and after rel/install.sh has repointed
# `current` it is the NEW release's cookie calling the old node, which refuses it. SIGTERM to
# the BEAM is the stop, and KillMode=mixed below keeps it an ordered one.
# Stopping the runner ends the sessions it supervises: they are in its cgroup.
# mixed, not control-group: SIGTERM goes to the BEAM alone, which ends its sessions through
# ProcessGroup.terminate/3; whatever is left in the cgroup after it exits gets SIGKILL.
# control-group would TERM every session at the same moment, before the runner could.
KillMode=mixed
# Exit status 78 is a refusal retrying cannot fix (wrong machine, contract, topic, token
# file): never restarted, so the unit shows failed at once instead of burning the start
# limit, which would also refuse the operator's own restart after fixing the config.
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=10
# No PrivateDevices=true: a user manager cannot drop the capabilities it needs, and the
# unit fails 218/CAPABILITIES (measured on Ubuntu 26.04, systemd --user).

[Install]
WantedBy=default.target
